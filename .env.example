# Recommended cloud PostgreSQL connection string
DATABASE_URL=""
PGPOOL_MAX=5



# Supabase - REQUIRED in production
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_PUBLISHABLE_KEY=""


# Authentication - REQUIRED in production
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_SESSION_HOURS=8
SESSION_SECRET=""

# Optional Smart Capital visitor/demo access
